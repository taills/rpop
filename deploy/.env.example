# rpop 镜像（CI 推送到私有 registry 的地址）
RPOP_IMAGE=registry.example.com/ty-apps/rpop:latest
RPOP_ADMIN_PORT=8080

# 启用的可选日志存储，逗号分隔：s3,clickhouse,elasticsearch；留空只启动 rpop
COMPOSE_PROFILES=

# RustFS（profile: s3）
RUSTFS_VERSION=latest
RUSTFS_ACCESS_KEY=rpop-logs
RUSTFS_SECRET_KEY=CHANGE_ME_rustfs_secret
RUSTFS_BUCKET=rpop-access-logs

# ClickHouse（profile: clickhouse）
CLICKHOUSE_VERSION=25.8
CLICKHOUSE_DB=rpop
CLICKHOUSE_USER=rpop
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password

# Elasticsearch（profile: elasticsearch）
ELASTICSEARCH_VERSION=8.19.4
ELASTIC_PASSWORD=CHANGE_ME_elastic_password
ES_JAVA_OPTS="-Xms1g -Xmx1g"
