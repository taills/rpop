# rpop 节点（node 模式）的环境变量，配合 deploy/docker-compose.node.example.yml 使用。
# 更方便的做法：在控制台“节点管理”新建节点后，join token 弹窗里的接入向导会直接生成
# 带真实 controller 地址与一次性 token 的完整内容，可直接复制使用。

# rpop 节点镜像（与控制器同版本；内网环境请替换为私有镜像源地址）
RPOP_IMAGE=registry.example.com/ty-apps/rpop:latest

# 控制器的 southbound 地址，节点通过它接入控制器
RPOP_CONTROLLER=https://controller.example.com:7443

# 一次性 join token（控制台“节点管理”新建节点或重置 token 时获取）。
# 只有首次注册需要；注册成功后清空这一行并 docker compose up -d 重建容器即可，无需重新填入。
RPOP_JOIN_TOKEN=
